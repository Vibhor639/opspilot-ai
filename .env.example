APP_ENV=local
APP_NAME=OpsPilot AI
API_V1_PREFIX=/api/v1
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=opspilot_documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Milestone 7: keep deterministic to avoid API usage; set to llm to opt in.
AGENT_REASONING_MODE=deterministic
MAX_UPLOAD_MB=10

# Agent workflow
AGENT_RUN_HISTORY=process_memory

# MCP server (run separately with python -m app.mcp_server.server)
MCP_SERVER_URL=http://127.0.0.1:8001/mcp


# Milestone 6: cloud provider integration
# Keep demo mode until provider credentials and IAM permissions are configured.
CLOUD_MODE=demo
AWS_REGION=us-east-1
# AWS credentials should use the standard AWS credential chain (profile/SSO/role).
# Avoid committing AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY to source control.
GCP_PROJECT_ID=
# Optional GCP billing export (BigQuery) configuration.
GCP_BILLING_PROJECT=
GCP_BILLING_DATASET=
GCP_BILLING_TABLE=
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Milestone 8: human approval workflow (use a long random secret; never commit .env)
APPROVAL_DB_PATH=./data/approvals.db
APPROVAL_API_TOKEN=replace-with-a-unique-random-secret
